{{> head}}
<div class="page-shell predictor-shell">
    {{> header}}

    <section class="predictor-panel" aria-label="Prediction controls">
        <form id="predictorForm" method="get" action="/predictor" class="predictor-form">
            <div class="predictor-field-row">
                <div>
                    <label for="homeTeam">Home Team</label>
                    <select id="homeTeam" name="homeTeam">
                        {{#homeTeams}}
                            <option value="{{abbreviation}}" {{#selected}}selected{{/selected}}>{{displayName}}</option>
                        {{/homeTeams}}
                    </select>
                </div>

                <div>
                    <label for="awayTeam">Away Team</label>
                    <select id="awayTeam" name="awayTeam">
                        {{#awayTeams}}
                            <option value="{{abbreviation}}" {{#selected}}selected{{/selected}}>{{displayName}}</option>
                        {{/awayTeams}}
                    </select>
                </div>
            </div>

            <div class="button-group">
                <button id="predictorSubmit" class="button primary" type="submit">Run Prediction</button>
                <a class="button secondary" href="/home">Back Home</a>
            </div>
        </form>
    </section>

    {{#hasPrediction}}
        {{#prediction}}
            <section class="prediction-card" aria-label="Prediction result">
                <div class="prediction-matchup">
                    <div>
                        <p class="predictor-label">Home</p>
                        <h2>{{homeTeamName}}</h2>
                        <span>{{homeAbbreviation}} - {{homeRecord}}</span>
                    </div>

                    <div class="prediction-versus">vs</div>

                    <div>
                        <p class="predictor-label">Away</p>
                        <h2>{{awayTeamName}}</h2>
                        <span>{{awayAbbreviation}} - {{awayRecord}}</span>
                    </div>
                </div>

                <div class="probability-grid">
                    <div class="probability-box">
                        <div class="probability-heading">
                            <span>{{homeAbbreviation}}</span>
                            <strong>{{homeWinProbability}}</strong>
                        </div>
                        <div class="probability-track">
                            <div id="homeProbabilityFill" class="probability-fill" data-team="{{homeAbbreviation}}" data-probability="{{homeProbabilityWidth}}" style="width: {{homeProbabilityWidth}}"></div>
                        </div>
                    </div>

                    <div class="probability-box">
                        <div class="probability-heading">
                            <span>{{awayAbbreviation}}</span>
                            <strong>{{awayWinProbability}}</strong>
                        </div>
                        <div class="probability-track">
                            <div id="awayProbabilityFill" class="probability-fill" data-team="{{awayAbbreviation}}" data-probability="{{awayProbabilityWidth}}" style="width: {{awayProbabilityWidth}}"></div>
                        </div>
                    </div>
                </div>

                <div class="prediction-summary">
                    <div>
                        <p class="predictor-label">Projected Result</p>
                        <h3>{{projectedMargin}}</h3>
                    </div>
                    <div>
                        <p class="predictor-label">Confidence</p>
                        <h3>{{confidenceLabel}}</h3>
                    </div>
                    <div>
                        <p class="predictor-label">Training Games</p>
                        <h3>{{trainingGames}}</h3>
                    </div>
                </div>

                <p class="prediction-note">{{recommendation}}</p>
            </section>

            <section class="feature-grid" aria-label="Model features">
                <div class="feature-card">
                    <p class="predictor-label">{{homeAbbreviation}} Win Pct</p>
                    <strong>{{homeWinPct}}</strong>
                    <span>Point diff {{homePointDiff}}</span>
                </div>
                <div class="feature-card">
                    <p class="predictor-label">{{awayAbbreviation}} Win Pct</p>
                    <strong>{{awayWinPct}}</strong>
                    <span>Point diff {{awayPointDiff}}</span>
                </div>
                <div class="feature-card">
                    <p class="predictor-label">{{homeAbbreviation}} Scoring</p>
                    <strong>{{homePointsFor}}</strong>
                    <span>Allowed {{homePointsAgainst}}</span>
                </div>
                <div class="feature-card">
                    <p class="predictor-label">{{awayAbbreviation}} Scoring</p>
                    <strong>{{awayPointsFor}}</strong>
                    <span>Allowed {{awayPointsAgainst}}</span>
                </div>
            </section>
        {{/prediction}}
    {{/hasPrediction}}

    {{^hasPrediction}}
        <div class="card predictor-empty-state">
            <p>Load the NBA dataset to generate matchup predictions.</p>
        </div>
    {{/hasPrediction}}
</div>
<script>
    (() => {
        const form = document.querySelector("#predictorForm");
        const submitButton = document.querySelector("#predictorSubmit");
        const homeFill = document.querySelector("#homeProbabilityFill");
        const awayFill = document.querySelector("#awayProbabilityFill");
        const storageKey = "courtvisionPredictorProbabilities";
        const teamGradients = {
            ATL: "linear-gradient(90deg, #E03A3E, #C1D32F)",
            BOS: "linear-gradient(90deg, #007A33, #BA9653)",
            BKN: "linear-gradient(90deg, #000000, #767676)",
            CHA: "linear-gradient(90deg, #1D1160, #00788C)",
            CHI: "linear-gradient(90deg, #CE1141, #000000)",
            CLE: "linear-gradient(90deg, #860038, #FDBB30)",
            DAL: "linear-gradient(90deg, #00538C, #002B5E)",
            DEN: "linear-gradient(90deg, #0E2240, #FEC524)",
            DET: "linear-gradient(90deg, #C8102E, #1D42BA)",
            GSW: "linear-gradient(90deg, #1D428A, #FFC72C)",
            HOU: "linear-gradient(90deg, #CE1141, #000000)",
            IND: "linear-gradient(90deg, #002D62, #FDBB30)",
            LAC: "linear-gradient(90deg, #C8102E, #1D428A)",
            LAL: "linear-gradient(90deg, #552583, #FDB927)",
            MEM: "linear-gradient(90deg, #5D76A9, #12173F)",
            MIA: "linear-gradient(90deg, #98002E, #F9A01B)",
            MIL: "linear-gradient(90deg, #00471B, #EEE1C6)",
            MIN: "linear-gradient(90deg, #0C2340, #78BE20)",
            NOP: "linear-gradient(90deg, #0C2340, #C8102E)",
            NYK: "linear-gradient(90deg, #006BB6, #F58426)",
            OKC: "linear-gradient(90deg, #007AC1, #EF3B24)",
            ORL: "linear-gradient(90deg, #0077C0, #C4CED4)",
            PHI: "linear-gradient(90deg, #006BB6, #ED174C)",
            PHX: "linear-gradient(90deg, #1D1160, #E56020)",
            POR: "linear-gradient(90deg, #E03A3E, #000000)",
            SAC: "linear-gradient(90deg, #5A2D81, #63727A)",
            SAS: "linear-gradient(90deg, #000000, #C4CED4)",
            TOR: "linear-gradient(90deg, #CE1141, #000000)",
            UTA: "linear-gradient(90deg, #002B5C, #F9A01B)",
            WAS: "linear-gradient(90deg, #002B5C, #E31837)"
        };

        const gradientFor = (team) => teamGradients[team] || "linear-gradient(90deg, var(--primary), #38a28e)";

        const fadePreviousGradient = (fill, previousGradient) => {
            if (!fill || !previousGradient || previousGradient === fill.dataset.gradient) {
                return;
            }

            const overlay = document.createElement("span");
            overlay.className = "probability-color-overlay";
            overlay.style.background = previousGradient;
            fill.appendChild(overlay);

            requestAnimationFrame(() => {
                overlay.classList.add("probability-color-overlay-fade");
            });

            overlay.addEventListener("transitionend", () => overlay.remove(), { once: true });
        };

        const parsePercent = (value) => {
            const parsed = Number.parseFloat(String(value || "").replace("%", ""));
            return Number.isFinite(parsed) ? parsed : 0;
        };

        const current = {
            home: parsePercent(homeFill?.dataset.probability),
            away: parsePercent(awayFill?.dataset.probability),
            homeGradient: gradientFor(homeFill?.dataset.team),
            awayGradient: gradientFor(awayFill?.dataset.team)
        };

        if (homeFill) {
            homeFill.dataset.gradient = current.homeGradient;
            homeFill.style.background = current.homeGradient;
        }
        if (awayFill) {
            awayFill.dataset.gradient = current.awayGradient;
            awayFill.style.background = current.awayGradient;
        }

        let previous = null;
        try {
            previous = JSON.parse(sessionStorage.getItem(storageKey) || "null");
        } catch (error) {
            previous = null;
        }

        if (homeFill && awayFill && previous) {
            homeFill.style.width = `${previous.home}%`;
            awayFill.style.width = `${previous.away}%`;
            fadePreviousGradient(homeFill, previous.homeGradient);
            fadePreviousGradient(awayFill, previous.awayGradient);
            homeFill.classList.add("probability-fill-animate");
            awayFill.classList.add("probability-fill-animate");

            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    homeFill.style.width = `${current.home}%`;
                    awayFill.style.width = `${current.away}%`;
                });
            });
        }

        sessionStorage.setItem(storageKey, JSON.stringify(current));

        form?.addEventListener("submit", () => {
            if (homeFill && awayFill) {
                sessionStorage.setItem(storageKey, JSON.stringify(current));
            }
            submitButton.textContent = "Running...";
            submitButton.disabled = true;
        });
    })();
</script>
{{> footer}}

{{> head}}
<div class="page-shell rankings-shell">
    {{> header}}

    <section class="rankings-control-panel" aria-label="Ranking filters">
        <div>
            <p class="rankings-season">{{seasonLabel}}</p>
            <p class="rankings-note">Adjust this filter to exclude teams with fewer appearances.</p>
        </div>

        <form method="get" action="/rankings" class="ranking-form">
            <label for="minGames">Minimum Games</label>
            <div class="ranking-filter-row">
                <input id="minGames" name="minGames" type="number" min="1" max="82" value="{{minGames}}"/>
                <button class="button primary" type="submit">Update</button>
            </div>
        </form>
    </section>

    <div class="button-group rankings-nav">
        <a class="button secondary" href="/home">Back Home</a>
    </div>

    <div class="rankings-list">
        {{#rankings}}
            <article class="ranking-card">
                <div class="rank-badge">
                    <span>#{{rankNumber}}</span>
                    <small>Rank</small>
                </div>

                <div class="rank-main">
                    <div class="rank-heading">
                        <h2>{{teamName}}</h2>
                        <span>{{abbreviation}}</span>
                    </div>
                    <p>{{wins}}-{{losses}} over {{gamesPlayed}} games</p>
                </div>

                <dl class="rank-stats">
                    <div>
                        <dt>Win Pct</dt>
                        <dd>{{winPct}}</dd>
                    </div>
                    <div>
                        <dt>Points For</dt>
                        <dd>{{pointsFor}}</dd>
                    </div>
                    <div>
                        <dt>Points Against</dt>
                        <dd>{{pointsAgainst}}</dd>
                    </div>
                    <div>
                        <dt>Avg Diff</dt>
                        <dd>{{pointDiff}}</dd>
                    </div>
                </dl>
            </article>
        {{/rankings}}
    </div>

    {{^rankings}}
        <div class="card ranking-empty-state">
            <p>No rankings are available for the selected minimum games filter.</p>
        </div>
    {{/rankings}}
</div>
{{> footer}}

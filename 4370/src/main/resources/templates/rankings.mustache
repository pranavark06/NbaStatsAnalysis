{{> head}}
<div class="page-shell rankings-shell">
    {{> header}}

    <section class="rankings-control-panel" aria-label="Ranking filters">
        <div>
            <p class="rankings-season">Regular Season Rankings</p>
            <p class="rankings-note">Choose a season to rank teams by wins and scoring margin.</p>
        </div>
    </section>

    <div class="button-group rankings-nav">
        <a class="button secondary" href="/home">Back Home</a>
    </div>

    <div class="rankings-list">
        {{#rankings}}
            <article class="ranking-card">
                <div class="rank-badge">
                    <span>#{{rankNumber}}</span>
                    <small>Rank</small>
                </div>

                <div class="rank-main">
                    <div class="rank-heading">
                        <h2>{{teamName}}</h2>
                        <span>{{abbreviation}}</span>
                    </div>
                    <p>{{wins}}-{{losses}} over {{gamesPlayed}} games</p>
                </div>

                <dl class="rank-stats">
                    <div>
                        <dt>Win Pct</dt>
                        <dd>{{winPct}}</dd>
                    </div>
                    <div>
                        <dt>Points For</dt>
                        <dd>{{pointsFor}}</dd>
                    </div>
                    <div>
                        <dt>Points Against</dt>
                        <dd>{{pointsAgainst}}</dd>
                    </div>
                    <div>
                        <dt>Avg Diff</dt>
                        <dd>{{pointDiff}}</dd>
                    </div>
                </dl>
            </article>
        {{/rankings}}
    </div>

    {{^rankings}}
        <div class="card ranking-empty-state">
            <p>No rankings are available for the selected season.</p>
        </div>
    {{/rankings}}
</div>
{{> footer}}
